{
  "cli": { "version": ">= 5.0.2", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "android": { "buildType": "apk" },
      "distribution": "internal",
      "channel": "preview",
      "env": { "EAS_BUILD_NO_EXPO_GO_WARNING": "true" }
    },
    "production": {
      "android": { "buildType": "app-bundle" },
      "distribution": "internal",
      "channel": "production",
      "autoIncrement": true,
      "env": { "EAS_BUILD_NO_EXPO_GO_WARNING": "true" }
    }
  },
  "submit": { "production": {} }
}
